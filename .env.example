# Copy to .env and fill in your key:   cp .env.example .env
# NEVER commit .env - .gitignore already excludes it.
#
# gcode loads .env automatically, in this order:
#   1. the folder you run gcode from   (per-project overrides)
#   2. the folder gcode.py lives in    (your global default)
# Real environment variables always win over both.
#
# Keep one KEY=VALUE per line. Lines starting with # are ignored.


# ---- required ----------------------------------------------------------

OPENAI_API_KEY=sk-proj-REPLACE_ME


# ---- recommended -------------------------------------------------------

# Who to attribute spend to in `gcode --usage`. Set this or the report
# just says whatever your Windows/Unix username is.
GCODE_USER=your-name

# Default model. Override per run with `gcode -m <name>`, or mid-session
# with `/model <name>`. Any model your key can reach works, as long as it
# supports tool calling. `gcode --models` lists them with prices.
# If this model needs org verification and your org isn't verified, gcode
# falls back automatically - set the fallback here to stop the notice.
GCODE_MODEL=gpt-5.4


# ---- optional ----------------------------------------------------------

# Hard stop: abandon a turn once it has spent this many USD. 0 = no cap.
GCODE_BUDGET=0

# Where the usage log lives. Point the whole team at a shared drive to get
# one combined report instead of one log per machine.
# GCODE_HOME=C:\shared\gcode

# Prices for models missing from the PRICES table in gcode.py, so they stop
# logging $0. USD per 1M tokens: [input, cached input, output].
# GCODE_PRICES={"gpt-5.1-codex":[1.25,0.125,10.00]}

# Any OpenAI-compatible endpoint: OpenRouter, Together, local Ollama/vLLM.
# Use the matching key in OPENAI_API_KEY above.
# OPENAI_BASE_URL=http://localhost:11434/v1

# Disable colored output on consoles that show raw escape codes.
# NO_COLOR=1
