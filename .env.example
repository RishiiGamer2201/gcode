# Copy to .env and fill in your key. NEVER commit .env.
# gcode loads .env automatically: first the folder you run it from, then the
# folder gcode.py lives in. Real environment variables always win.

OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional. Delete the ones you don't need.

# who to attribute spend to in the usage log
GCODE_USER=your-name

# default model
GCODE_MODEL=gpt-5

# USD cap per turn, 0 = no cap
GCODE_BUDGET=0
